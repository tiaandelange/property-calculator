{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd frontend && npm ci --no-audit --no-fund --ignore-scripts",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "trailingSlash": false,

  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "proplytic.co.za" }],
      "destination": "https://www.proplytic.co.za/:path*",
      "permanent": true
    }
  ],

  "crons": [
    {
      "path": "/api/cron/run-due",
      "schedule": "0 6 * * *"
    }
  ],

  "functions": {
    "frontend/api/[...path].ts": {
      "includeFiles": "frontend/assets/fonts/pdfmake/**,frontend/public/assets/brand/**,frontend/api/_lib/propertyCalculator/**,frontend/api/_lib/propertyCalculator.server.mjs",
      "maxDuration": 60,
      "memory": 1024
    },
    "frontend/api/statements/generate.ts": {
      "includeFiles": "frontend/assets/fonts/pdfmake/**,frontend/public/assets/brand/**,frontend/api/_lib/propertyCalculator/**,frontend/api/_lib/propertyCalculator.server.mjs",
      "maxDuration": 60,
      "memory": 1024
    },
    "frontend/api/statements/[id]/send-email.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "frontend/api/subscription/webhook.ts": {
      "maxDuration": 60
    }
  },

  "rewrites": [
    {
      "source": "/((?!api/|social/|assets/|.*\\..+$).*)",
      "destination": "/index.html"
    }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "geolocation=(), camera=(), microphone=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/social/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
