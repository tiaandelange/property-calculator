###############################################################################
# PRODUCTION env template for the frontend (Vercel).
#
# Paste these values into the Vercel project's "Environment Variables" UI.
#
# ##############################################################################
# # WARNING — read before adding any new variable                              #
# ##############################################################################
# # Every variable that starts with `VITE_` is INLINED into the JavaScript     #
# # bundle at build time. Anyone visiting your site can read it by viewing     #
# # the bundle source. Therefore:                                              #
# #                                                                            #
# #   - NEVER put server-only secrets here (JWT_SECRET, DATABASE_URL,          #
# #     STRIPE_SECRET_KEY, OAuth client secrets, signing keys, ...).           #
# #   - Public identifiers are fine (Stripe PUBLISHABLE key, GA tracking ID,   #
# #     Sentry DSN, Cloudflare Turnstile site-key).                            #
# #                                                                            #
# #   - NEVER: SUPABASE_SERVICE_ROLE_KEY, STRIPE_SECRET_KEY,                   #
# #     STRIPE_WEBHOOK_SECRET, SUPABASE_JWT_SECRET, DATABASE_URL, JWT_SECRET.  #
# #     Those belong on the backend or Vercel **server** functions only.       #
# ##############################################################################

# Supabase (required for Auth + migrated data). Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Canonical production origin used for Supabase auth email links.
# If you deploy previews, you can still keep auth links pointing at production.
# VITE_PUBLIC_SITE_URL=https://proplytic.co.za

# Do NOT set VITE_API_BASE_URL in production — the SPA uses same-origin /api (Vercel Functions).
# Only set for local dev if you still run a separate API host (not required after cutover).

# Vercel serverless (frontend/api/*) — set in Vercel project Environment Variables:
#   SUPABASE_URL (or duplicate VITE_SUPABASE_URL)
#   SUPABASE_ANON_KEY (or duplicate VITE_SUPABASE_ANON_KEY)
#   SUPABASE_SERVICE_ROLE_KEY — cron, Stripe webhook, service writes
#   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET
#   FRONTEND_URL — https://yourdomain.com (Stripe redirect URLs)
#   CRON_SECRET — for /api/cron/run-due
#   RESEND_API_KEY — invoice + contact form email (server only; never VITE_*)
#   INVOICE_EMAIL_FROM — verified Resend sender for invoices (optional)
#   CONTACT_FROM_EMAIL — required for POST /api/contact (verified Resend sender)
#   CONTACT_TO_EMAIL — optional inbox override (default: delangetiaanoffice@gmail.com)
# Never expose service role or Stripe secrets as VITE_*.

# Public Stripe publishable key — used by Stripe.js in the browser to tokenise
# card details. This is NOT a secret; safe to expose.
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
