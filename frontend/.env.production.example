###############################################################################
# PRODUCTION env template for the frontend (Vercel).
#
# Paste these values into the Vercel project's "Environment Variables" UI.
#
# ##############################################################################
# # WARNING — read before adding any new variable                              #
# ##############################################################################
# # Every variable that starts with `VITE_` is INLINED into the JavaScript     #
# # bundle at build time. Anyone visiting your site can read it by viewing     #
# # the bundle source. Therefore:                                              #
# #                                                                            #
# #   - NEVER put server-only secrets here (JWT_SECRET, DATABASE_URL,          #
# #     STRIPE_SECRET_KEY, OAuth client secrets, signing keys, ...).           #
# #   - Public identifiers are fine (Stripe PUBLISHABLE key, GA tracking ID,   #
# #     Sentry DSN, Cloudflare Turnstile site-key).                            #
# #                                                                            #
# # Server-only secrets belong on the BACKEND host, in Render/Railway env vars.#
###############################################################################

# Backend API base URL.
# Recommended: a Cloudflare-proxied custom subdomain that forwards to your
# Render/Railway backend. This puts the WAF, DDoS protection and edge cache in
# front of every API request and lets you swap backend providers without
# touching the bundle.
VITE_API_BASE_URL=https://api.yourdomain.com/api

# Public Stripe publishable key — used by Stripe.js in the browser to tokenise
# card details. This is NOT a secret; safe to expose.
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
