###############################################################################
# DEVELOPMENT env template for the FRONTEND (Vite — PUBLIC at build time).
#
#   cp frontend/.env.example frontend/.env.local   # recommended (.env.local is gitignored)
#
# CRITICAL: every `VITE_*` value is inlined into the JS bundle. Treat as world-readable.
#
# Supabase in the browser: ONLY these two (see src/lib/supabaseClient.ts):
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_ANON_KEY
#
# NEVER in frontend env or source: SUPABASE_SERVICE_ROLE_KEY, SUPABASE_JWT_SECRET,
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, DATABASE_URL, JWT_SECRET, or any `sk_*` / `whsec_*`.
#
# Allowed examples: API base URL, anon key, Stripe *publishable* key (pk_…) if you add one.
###############################################################################

# Backend API base URL — Vite reads this at build time. For local dev, point
# at the backend you started with `npm run dev` (or docker compose).
VITE_API_BASE_URL=http://localhost:4000/api

# Alias kept for backwards compatibility.
# VITE_API_URL=http://localhost:4000/api

###############################################################################
# Supabase (Phase 1 — browser client; anon key only, safe to expose in bundle)
#
# Get both from: https://supabase.com/dashboard → your project →
#   Project Settings (gear) → API
#   - Project URL     → VITE_SUPABASE_URL
#   - anon public key → VITE_SUPABASE_ANON_KEY
#
# Do NOT paste the service_role secret here or in any VITE_* variable.
#
# Local: copy this file to `.env.local` and replace placeholders with real values:
#   cp .env.example .env.local
###############################################################################
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# For email confirmation links, add these URLs in Supabase Dashboard → Authentication → URL configuration:
#   Site URL: http://localhost:5173 (dev) or your production origin
#   Redirect URLs: include http://localhost:5173/confirm-email and production /confirm-email
