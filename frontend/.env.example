###############################################################################
# DEVELOPMENT env template for the frontend.
#
# Copy to `frontend/.env` for local work:  cp frontend/.env.example frontend/.env
#
# CRITICAL: every value in this file is BAKED INTO THE PRODUCTION BUNDLE and
# is therefore PUBLIC. NEVER put secret keys, database URLs, or anything you
# wouldn't paste into a public chat in here.
#
# Allowed: API base URLs, public Stripe/Cloudflare/Analytics IDs.
# Not allowed: JWT_SECRET, DATABASE_URL, STRIPE_SECRET_KEY, anything starting
#              with `*_SECRET` or `sk_*`.
###############################################################################

# Backend API base URL — Vite reads this at build time. For local dev, point
# at the backend you started with `npm run dev` (or docker compose).
VITE_API_BASE_URL=http://localhost:4000/api

# Alias kept for backwards compatibility.
# VITE_API_URL=http://localhost:4000/api
