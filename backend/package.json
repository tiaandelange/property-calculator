{
  "name": "the-property-guy-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "verify:public-env": "node scripts/verify-public-frontend-env.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "confirm:admin": "tsx scripts/legacy-prisma-migration/confirm-admin.ts",
    "cleanup:financials": "tsx scripts/legacy-prisma-migration/cleanup-property-financials.ts",
    "cleanup:leases": "tsx scripts/legacy-prisma-migration/cleanup-duplicate-leases.ts",
    "cleanup:tenants": "tsx scripts/legacy-prisma-migration/cleanup-duplicate-tenants.ts",
    "tenants:list": "tsx scripts/legacy-prisma-migration/list-tenants.ts",
    "backup:portfolio-data": "tsx scripts/legacy-prisma-migration/export-portfolio-backup.ts",
    "reset:portfolio-data": "tsx scripts/legacy-prisma-migration/reset-portfolio-data.ts"
  },
  "prisma": {
    "seed": "tsx scripts/legacy-prisma-migration/prisma/seed.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "stripe": "^16.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
