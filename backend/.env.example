###############################################################################
# DEVELOPMENT env template for the BACKEND (Node / Express only).
#
#   cp backend/.env.example backend/.env
#
# For production host UI, see backend/.env.production.example
###############################################################################

# =============================================================================
# SERVER-ONLY — never copy these names/values into frontend/ or any VITE_*
# =============================================================================
# The Vite bundle inlines every VITE_* variable; anything there is PUBLIC.
#
# Required on the backend during the Supabase migration bridge:
#   SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY   (service_role — bypasses RLS; NEVER in SPA)
#   SUPABASE_JWT_SECRET         (verifies Supabase access tokens on Express)
#   STRIPE_SECRET_KEY           (sk_… — Stripe API; server-only)
#   STRIPE_WEBHOOK_SECRET       (whsec_… — webhook signature; server-only)
#
# Also server-only (not for Vite):
#   DATABASE_URL, JWT_SECRET, SMTP_*, etc.
# =============================================================================

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Set the number of upstream proxy hops to trust. Defaults to 1 in production
# (Cloudflare → Render → app) and `false` otherwise. Only override if you
# fully understand the implication for IP-based rate limiting.
# TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Database (server-only)
# ---------------------------------------------------------------------------
# Local Postgres (via docker-compose):
DATABASE_URL="postgresql://propertyguy:propertyguy@localhost:5432/propertyguy?schema=public"

# ---------------------------------------------------------------------------
# Auth (server-only)
# ---------------------------------------------------------------------------
# JWT_SECRET MUST be set to a strong, non-placeholder value of at least 32
# characters when NODE_ENV=production. The server refuses to boot in
# production otherwise. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-this-secret"
JWT_EXPIRES_IN="1d"

# ---------------------------------------------------------------------------
# Supabase — BACKEND process.env (see src/config/env.ts)
# ---------------------------------------------------------------------------
# Project URL — same value you mirror as VITE_SUPABASE_URL on the frontend.
SUPABASE_URL=""
#
# service_role — bypasses Row Level Security. Used by src/config/supabaseClient.ts
# for trusted admin/server jobs ONLY. Never expose to the browser or Vercel
# "client" env; never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=""
#
# JWT Secret from Dashboard → Settings → API (signs user access tokens).
# Express uses this to verify Authorization: Bearer <supabase access_token>
# during the legacy Prisma bridge. Server-only — not a VITE_* variable.
SUPABASE_JWT_SECRET=""
#
# anon public key — optional on Express today; for future server calls that
# must respect RLS with a user JWT. Safe in the browser ONLY with RLS policies;
# the SPA should use VITE_SUPABASE_ANON_KEY (frontend/.env.example), not this file.
SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------------------
# CORS / allowed frontend origins
# ---------------------------------------------------------------------------
# Either FRONTEND_URL (single origin) or FRONTEND_URLS (comma-separated list).
# FRONTEND_URLS takes precedence when both are set.
FRONTEND_URL="http://localhost:5173"
# FRONTEND_URLS="https://app.example.com,https://www.example.com"

# ---------------------------------------------------------------------------
# Email (server-only when wired)
# ---------------------------------------------------------------------------
EMAIL_FROM="no-reply@thepropertyguy.co.za"

# ---------------------------------------------------------------------------
# Stripe (server-only)
# ---------------------------------------------------------------------------
# Without STRIPE_SECRET_KEY the /checkout endpoint falls back to a local mock.
# STRIPE_WEBHOOK_SECRET is REQUIRED for /api/subscription/webhook to accept
# any event — without it the route returns 503 and refuses to grant
# subscriptions.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Test-only
# ---------------------------------------------------------------------------
# Override the on-disk reports root for integration tests. Do NOT set this in
# normal dev or production — the integration suite sets it automatically.
# REPORTS_ROOT_OVERRIDE=/tmp/your-reports-dir
