###############################################################################
# PRODUCTION env template for the BACKEND (server-only).
#
# DO NOT commit a populated copy. Paste into Render / Railway / Vercel **server**
# (Node) env — never into Vercel "client" or Expo public env.
#
# Forbidden in the SPA / Vite bundle: SUPABASE_SERVICE_ROLE_KEY, STRIPE_SECRET_KEY,
# STRIPE_WEBHOOK_SECRET, SUPABASE_JWT_SECRET, DATABASE_URL, JWT_SECRET (see frontend/.env.production.example).
#
# Every value below is either:
#   - REQUIRED — the server refuses to boot without it (or it fails closed)
#   - REQUIRED-IF-USED — only needed if you enable the feature (Stripe)
#   - OPTIONAL — sensible default applied if unset
###############################################################################

# ---------------------------------------------------------------------------
# Runtime  (REQUIRED — your platform sets PORT for you, but you MUST set this)
# ---------------------------------------------------------------------------
NODE_ENV=production

# PORT is injected by Render/Railway automatically. Do NOT hard-code it here
# unless you have a very specific reason — the platform may use a random port.
# PORT=4000

# Number of upstream proxy hops Express should trust when reading client IPs.
#  - Render direct (no Cloudflare):            1
#  - Cloudflare → Render:                       2
#  - Cloudflare → Render with internal nginx:   3
# Wrong values either silently break IP-based rate limiting or let attackers
# spoof X-Forwarded-For. When in doubt, leave the default (1).
# TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Database  (REQUIRED — Supabase connection string)
# ---------------------------------------------------------------------------
# In the Supabase dashboard:
#   Settings → Database → Connection string → URI → "Transaction" mode
# Append `?pgbouncer=true&connection_limit=1` for serverless/edge runtimes.
# For a long-lived Render container, the "Session" mode (port 5432) is fine
# and gives you LISTEN/NOTIFY + prepared statements.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"

# ---------------------------------------------------------------------------
# Auth  (REQUIRED)
# ---------------------------------------------------------------------------
# 48 random bytes hex-encoded. Generate ONCE per environment and never reuse:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating this value invalidates every outstanding JWT AND every signed
# download URL — by design.
JWT_SECRET="<paste a 96-character hex string here>"

# Short-lived tokens. Default is 1h. Increase only if you have a refresh-token
# flow in place.
JWT_EXPIRES_IN="1h"

# Supabase — Dashboard → Settings → API (all server-side here)
SUPABASE_URL="https://<project-ref>.supabase.co"
# Service role: `src/config/supabaseClient.ts` — bypasses RLS. NEVER in frontend or VITE_*.
SUPABASE_SERVICE_ROLE_KEY=""
# Verifies Supabase access tokens on Express (legacy bridge). NEVER in VITE_*.
SUPABASE_JWT_SECRET="<paste JWT Secret from Supabase>"
# Anon key: optional on this server for future RLS-respecting Node calls with a user JWT.
SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------------------
# CORS  (REQUIRED — at least one of FRONTEND_URL or FRONTEND_URLS)
# ---------------------------------------------------------------------------
# Use FRONTEND_URLS to authorise multiple origins (e.g. the production domain
# AND your Vercel preview deployments).
FRONTEND_URLS="https://app.example.com,https://www.example.com"

# Or, for a single origin:
# FRONTEND_URL="https://app.example.com"

# ---------------------------------------------------------------------------
# Email  (OPTIONAL — placeholder while no real SMTP is wired)
# ---------------------------------------------------------------------------
EMAIL_FROM="no-reply@yourdomain.com"

# ---------------------------------------------------------------------------
# Stripe  (REQUIRED-IF-USED)
# ---------------------------------------------------------------------------
# Without STRIPE_SECRET_KEY the /checkout endpoint falls back to a mock URL.
# STRIPE_WEBHOOK_SECRET is REQUIRED for /api/subscription/webhook to grant any
# subscription — without it the route returns 503.
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
